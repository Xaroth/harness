# uid/gid the container user runs as; match your host user (id -u / id -g)
PUID=1000
PGID=1000
# container timezone
TZ=UTC
# host directory holding your repos
WORKSPACE_HOST=./workspace
# path inside the container; set equal to the host path if you touch repos from both sides (t3 stores absolute paths)
WORKSPACE=/workspace
# host port, bound to 127.0.0.1 only
PORT=3773
# public https URL your reverse proxy serves, used by `pair` for pairing links
PUBLIC_URL=
# image to run; override to pin a version, e.g. ghcr.io/xaroth/harness:v0.1.0
IMAGE=ghcr.io/xaroth/harness:latest
# 1 enables t3 PostHog and OTel telemetry, 0 disables both
T3_TELEMETRY=0
# 1 starts sshd inside the container (key auth, user code). Drop your public key in the config volume at ssh/authorized_keys
SSHD=0
# where port 22 of the container is published; VS Code Remote SSH connects here
SSH_BIND=127.0.0.1
SSH_PORT=2222
# container hostname; t3's open-in-editor link becomes <hostname>.local
CONTAINER_HOSTNAME=harness
# install newer versions at container start, on top of the image's: comma-separated claude, t3,
# each optionally @version or @tag (claude@2.1.290, t3@preview). Empty uses the image versions
AUTO_UPDATE=
# seconds allowed per install before falling back to the image version
AUTO_UPDATE_TIMEOUT=120
